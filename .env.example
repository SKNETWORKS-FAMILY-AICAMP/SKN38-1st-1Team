# 이 파일을 복사해 .env 파일을 만들고 실제 값을 입력하세요.
# .env 파일은 GitHub에 올라가지 않습니다. 실제 키·비밀번호를 이 파일에 적지 마세요.

# 국토교통부 통계누리 OpenAPI (자동차등록대수현황 시도별)
MOLIT_API_KEY=
# 인증키(key=)와 기간(start_dt, end_dt)을 뺀 요청 URL — 코드에서 자동으로 붙입니다.
MOLIT_API_URL=https://stat.molit.go.kr/portal/openapi/service/rest/getList.do?form_id=5498&style_num=2

# 카카오 (https://developers.kakao.com → 내 애플리케이션 → 앱 키)
# REST API 키: 주소·장소 검색, 길찾기(서버에서만 사용)
KAKAO_REST_API_KEY=
# JavaScript 키: 운송 신청 화면의 지도 표시 (플랫폼 > Web에 http://localhost:8501 등 사이트 도메인 등록 필요)
KAKAO_JAVASCRIPT_KEY=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# 클라우드 MySQL(배포용)처럼 암호화 연결이 필요하면 true (로컬 MySQL은 비워 두기)
DB_SSL=
